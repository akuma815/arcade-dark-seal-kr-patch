{
 "_note": "모델 초벌(2026-10-04). 한 줄 = 셀 열(글자·공백·문장부호 각 1셀), 본문 화면은 선두 여백 1셀 + 최대 14셀 × 4줄. 사람 검토 전.",
 "A:07ba18": {"ko_rows": [
  "백성의 마음에 검은 그림자",
  "가득하고, 아득한 땅 밑의",
  "문이 열리던 때, 그 암흑",
  "속에서 나온 마의 무리가",
  "세상을 사악한 어둠으로",
  "덮으려 하니,",
  "",
  "그때, 숙명으로 모인",
  "용사들이 빛의 힘과 기예로",
  "이를 봉인하리라.",
  "그리하여 다시 세상에",
  "빛이 가득하리라.",
  "",
  "(에트루리아 전승에서)"],
  "notes": "가로쓰기·아래→위 크롤로 재배치(PoC-2). 원문 후리가나(うち·さだめ·もののふ)는 생략."},
 "A:07bc62": {"ko_rows": ["용사들의 전설이", "지금 시작된다‥‥"], "notes": "원본 블록 40B 한도라 2행 들여쓰기 생략(원문은 5셀 들여씀)"},
 "A:07bf10": {"ko_rows": ["이곳 에트루리아 왕국은", "평화로 가득했다. 그러나‥", "사람들 마음에 사악한", "어둠의 그림자가 번졌다‥."]},
 "A:07bf8e": {"ko_rows": ["이윽고 마계의 문이 열리고", "사악한 마물들이 세상에", "넘쳐흐르기 시작했다‥‥."]},
 "A:07bfe8": {"ko_rows": ["사람들은 기다렸다‥‥.", "전승 속 “빛의 용사”가", "이 세상에 다시", "강림하기를‥‥."]},
 "A:07c044": {"ko_rows": ["그리고 숙명에 이끌린", "네 젊은이가", "나타났던 것이다‥."], "notes": "원문은 세로 2열. 가로 3줄로 재배치 — 표시 위치는 빌드 후 화면 확인"},
 "A:07c224": {"ko_rows": ["그대들에게 부탁이 있네.", "근처 오래된 탑에 눌러앉은", "비룡을 한시라도 빨리", "퇴치해 주게. 부탁하네‼"]},
 "A:07c2aa": {"ko_rows": ["여기서 남서쪽 “서리봉”의", "왕실 직할 제빙 동굴에", "마물이 나타났네! 한시라도", "서둘러 퇴치해 주게‼"], "notes": "霜ヶ峰→서리봉(의역). 頼んだぞ 생략(폭 제한)"},
 "A:07c330": {"ko_rows": ["내 딸 “에밀리아”가 몰래", "타라스 시로 떠났다 하네.", "그 고개엔 마물이 나오네.", "공주를 데려와 주게‼"], "notes": "頼んだぞ 는 ‼ 로 흡수"},
 "A:07c3b6": {"ko_rows": ["납치된 공주를 되찾으려면", "데로스 화산 동굴에 있다는", "“신의 경옥”과", "성스런 보관을 가져오게‼"], "notes": "神の硬玉/聖なる宝冠 — 아이템명 표기 사람 확인. 둘째 따옴표는 폭 때문에 생략"},
 "A:07c43c": {"ko_rows": ["이번에야말로 공주와 빼앗긴", "신기를 마물들에게서 되찾고", "그 힘으로 마물들을 다시", "“마계의 문”에 봉인하게‼"]},
 "A:07c4e4": {"ko_rows": ["그대들의 활약, 참으로", "훌륭했네. 상을 내리지‼", "정말 잘해 주었네.", "다음에도 기대하겠네‼"]},
 "A:07c562": {"ko_rows": ["이럴 수가! 공주가", "납치당하다니! 허나 명색이", "왕녀, 쉽게 죽이진 않을", "테지만‥‥. 걱정이구나."]},
 "A:07c5e8": {"ko_rows": ["두 신기 중 하나를", "빼앗겼다고? 이대로는", "세계가 마물들의 것이 되고", "만다. 믿을 건 그대들뿐‼"]},
 "A:07c68c": {"ko_rows": ["네놈들 마법은 내 마력으로", "봉인했다. 이제 마법은", "쓸 수 없다‥‼", "어둠의 힘을 맛보아라‼"]},
 "A:07c702": {"ko_rows": ["어찌 날 방해하는 것이냐!", "허나 그것도 여기까지다‼", "내 종 “젤라”의 먹이가", "되어라‼ 핫하하하하‥."], "notes": "ゼラー 표기(젤라/제라) 사람 확인"},
 "A:07c782": {"ko_rows": ["역시 왔군‥! 이것으로", "왕녀를 포함한 다섯 제물이", "모두 모였다. 남은 건 두", "신기뿐! 여기서 죽어라‼"]},
 "A:07c806": {"ko_rows": ["이놈! 아직도 방해하는가!", "두 신기는 내가 가져가마‼", "가라 “파이레스”‼ 놈들을", "숯덩이로 만들어 버려라‼"], "notes": "ファイレス 표기 사람 확인"},
 "A:07c888": {"ko_rows": ["기어이 여기까지 왔느냐‼", "허나 문 너머 봉인된", "어둠의 제왕 “루시퍼”님의", "부활은 막지 못한다‼"], "notes": "私の計画 생략(폭 제한)"},
 "A:07c902": {"ko_rows": ["“고다”는 여흥일 뿐이다!", "이번엔 내가 상대다‼ 그", "두 신기는 문 너머", "“어비스” 깊이 묻어"], "notes": "다음 화면(07c98a)으로 문장이 이어짐"},
 "A:07c98a": {"ko_rows": ["다시는 못 쓰게 해주마‼", "그때야말로 “루시퍼”님이", "다스리는 “어둠의 세기”가", "열린다! 너희도 제물이다‼"]},
 "A:07ca0c": {"ko_rows": ["이리하여 네 용사는", "전승대로 마물을 다시", "봉인하고, 왕국에 다시", "평화를 가져온 것이다‥‥."]}
}

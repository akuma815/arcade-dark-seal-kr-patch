  {
   "id": "A:07bf10",
   "label": "story[0]",
   "addr": "07bf10",
   "size_bytes": 126,
   "source_rows": [
    "　ここエトルリア王国は、平和に",
    "",
    "　満ち溢れていた。　　しかし‥",
    "",
    "　人々の心には、邪悪な暗い影が",
    "",
    "　広がり始めていた‥。"
   ],
   "layout": {
    "rows": 7,
    "max_cells": 15,
    "lead_blank": 1,
    "vertical_original": false,
    "palettes": [
     0
    ]
   },
   "ko_rows": [
    "이곳 에트루리아 왕국은",
    "평화로 가득했다. 그러나‥",
    "사람들 마음에 사악한",
    "어둠의 그림자가 번졌다‥."
   ],
   "status": "approved",
   "notes": ""
  },
  {
   "id": "A:07bf8e",
   "label": "story[1]",
   "addr": "07bf8e",
   "size_bytes": 90,
   "source_rows": [
    "",
    "",
    "　やがて、魔界の門を開け、邪悪",
    "",
    "　な魔物共が、世に溢れていった",
    "",
    "　のである‥‥。"
   ],
   "layout": {
    "rows": 7,
    "max_cells": 15,
    "lead_blank": 1,
    "vertical_original": false,
    "palettes": [
     0
    ]
   },
   "ko_rows": [
    "이윽고 마계의 문이 열리고",
    "사악한 마물들이 세상에",
    "넘쳐흐르기 시작했다‥‥."
   ],
   "status": "approved",
   "notes": ""
  },
  {
   "id": "A:07bfe8",
   "label": "story[2]",
   "addr": "07bfe8",
   "size_bytes": 92,
   "source_rows": [
    "　人々は待った‥‥。",
    "",
    "　古い伝承にある“光の勇者”が、",
    "",
    "　この世に再臨することを‥‥。"
   ],
   "layout": {
    "rows": 5,
    "max_cells": 16,
    "lead_blank": 1,
    "vertical_original": false,
    "palettes": [
     0
    ]
   },
   "ko_rows": [
    "사람들은 기다렸다‥‥.",
    "전승 속 “빛의 용사”가",
    "이 세상에 다시",
    "강림하기를‥‥."
   ],
   "status": "approved",
   "notes": ""
  },
  {
   "id": "A:07c044",
   "label": "story[3]",
   "addr": "07c044",
   "size_bytes": 448,
   "source_rows": [
    "　若　　　　　　　　　　　　そ",
    "　者　　　　　　　　　　　　し",
    "　が　　　　　　　　　　　　て",
    "　、　　　　　　　　　　　　宿",
    "　現　　　　　　　　　　　　命",
    "　わ　　　　　　　　　　　　に",
    "　れ　　　　　　　　　　　　導",
    "　た　　　　　　　　　　　　か",
    "　の　　　　　　　　　　　　れ",
    "　で　　　　　　　　　　　　し",
    "　あ　　　　　　　　　　　　四",
    "　る　　　　　　　　　　　　人",
    "　：　　　　　　　　　　　　の",
    "　。　　　　　　　　　　　　　"
   ],
   "layout": {
    "rows": 14,
    "max_cells": 15,
    "lead_blank": 1,
    "vertical_original": true,
    "palettes": [
     0
    ]
   },
   "ko_rows": [
    "그리고 숙명에 이끌린",
    "네 젊은이가",
    "나타났던 것이다‥."
   ],
   "status": "approved",
   "notes": "원문은 세로 2열. 가로 3줄로 재배치 — 표시 위치는 빌드 후 화면 확인"
  },
  {
   "id": "A:07c224",
   "label": "briefing[0]",
   "addr": "07c224",
   "size_bytes": 134,
   "source_rows": [
    "　貴公等に頼みがあるのじゃ。　",
    "",
    "　近くの古い塔に住みついている",
    "",
    "　飛竜を一刻も早く、退治して　",
    "",
    "　もらいたいのじゃ。頼んだぞ‼"
   ],
   "layout": {
    "rows": 7,
    "max_cells": 15,
    "lead_blank": 1,
    "vertical_original": false,
    "palettes": [
     0
    ]
   },
   "ko_rows": [
    "그대들에게 부탁이 있네.",
    "근처 오래된 탑에 눌러앉은",
    "비룡을 한시라도 빨리",
    "퇴치해 주게. 부탁하네‼"
   ],
   "status": "approved",
   "notes": ""
  },
  {
   "id": "A:07c2aa",
   "label": "briefing[1]",
   "addr": "07c2aa",
   "size_bytes": 134,
   "source_rows": [
    "　此より南西の“霜ヶ峰”にある",
    "",
    "　王室直轄製氷洞内に、魔物が　",
    "",
    "　現れたのじゃ！一刻も早く退治",
    "",
    "　してもらいたい！頼んだぞ‼　"
   ],
   "layout": {
    "rows": 7,
    "max_cells": 15,
    "lead_blank": 1,
    "vertical_original": false,
    "palettes": [
     0
    ]
   },
   "ko_rows": [
    "여기서 남서쪽 “서리봉”의",
    "왕실 직할 제빙 동굴에",
    "마물이 나타났네! 한시라도",
    "서둘러 퇴치해 주게‼"
   ],
   "status": "approved",
   "notes": "霜ヶ峰→서리봉(의역). 頼んだぞ 생략(폭 제한)"
  },
  {
   "id": "A:07c330",
   "label": "briefing[2]",
   "addr": "07c330",
   "size_bytes": 134,
   "source_rows": [
    "　我が娘“エミリア”が、無断で",
    "",
    "　タラス市に向ったらしい。　　",
    "",
    "　あの峠には魔物が出るのじゃ。",
    "",
    "　姫を連れ戻すのだ！頼んだぞ‼"
   ],
   "layout": {
    "rows": 7,
    "max_cells": 15,
    "lead_blank": 1,
    "vertical_original": false,
    "palettes": [
     0
    ]
   },
   "ko_rows": [
    "내 딸 “에밀리아”가 몰래",
    "타라스 시로 떠났다 하네.",
    "그 고개엔 마물이 나오네.",
    "공주를 데려와 주게‼"
   ],
   "status": "approved",
   "notes": "頼んだぞ 는 ‼ 로 흡수"
  },
  {
   "id": "A:07c4c2",
   "label": "briefing[3]",
   "addr": "07c4c2",
   "size_bytes": 2,
   "source_rows": [
    ""
   ],
   "layout": {
    "rows": 1,
    "max_cells": 0,
    "lead_blank": 0,
    "vertical_original": false,
    "palettes": []
   },
   "ko_rows": [],
   "status": "untranslated",
   "notes": ""
  },
  {
   "id": "A:07c3b6",
   "label": "briefing[5]",
   "addr": "07c3b6",
   "size_bytes": 134,
   "source_rows": [
    "　誘拐された姫を取り戻す為に　",
    "",
    "　デロス火山洞内にあるという　",
    "",
    "　“神の硬玉”と“聖なる宝冠”",
    "",
    "　を持ち帰るのじゃ‼頼んだぞ‼"
   ],
   "layout": {
    "rows": 7,
    "max_cells": 15,
    "lead_blank": 1,
    "vertical_original": false,
    "palettes": [
     0
    ]
   },
   "ko_rows": [
    "납치된 공주를 되찾으려면",
    "데로스 화산 동굴에 있다는",
    "“신의 경옥”과",
    "성스런 보관을 가져오게‼"
   ],
   "status": "approved",
   "notes": "神の硬玉/聖なる宝冠 — 아이템명 표기 사람 확인. 둘째 따옴표는 폭 때문에 생략"
  },
  {
   "id": "A:07c43c",
   "label": "briefing[7]",
   "addr": "07c43c",
   "size_bytes": 134,
   "source_rows": [
    "　今度こそ、姫と奪われた神器を",
    "",
    "　魔物共から取り戻し、その力で",
    "",
    "　魔物を再び“魔界の扉”の中に",
    "",
    "　封じ込めるのじゃ‼頼んだぞ‼"
   ],
   "layout": {
    "rows": 7,
    "max_cells": 15,
    "lead_blank": 1,
    "vertical_original": false,
    "palettes": [
     0
    ]
   },
   "ko_rows": [
    "이번에야말로 공주와 빼앗긴",
    "신기를 마물들에게서 되찾고",
    "그 힘으로 마물들을 다시",
    "“마계의 문”에 봉인하게‼"
   ],
   "status": "approved",
   "notes": ""
  },
  {
   "id": "A:07c66e",
   "label": "king_message[0]",
   "addr": "07c66e",
   "size_bytes": 2,
   "source_rows": [
    ""
   ],
   "layout": {
    "rows": 1,
    "max_cells": 0,
    "lead_blank": 0,
    "vertical_original": false,
    "palettes": []
   },
   "ko_rows": [],
   "status": "untranslated",
   "notes": ""
  },
  {
   "id": "A:07c4e4",
   "label": "king_message[1]",
   "addr": "07c4e4",
   "size_bytes": 126,
   "source_rows": [
    "　貴公等の働き、真に見事であっ",
    "",
    "　た、褒美を取らそうぞ‼‥‥。",
    "",
    "　ほんとうに良くやってくれた。",
    "",
    "　次も期待しておるぞ‼"
   ],
   "layout": {
    "rows": 7,
    "max_cells": 15,
    "lead_blank": 1,
    "vertical_original": false,
    "palettes": [
     0
    ]
   },
   "ko_rows": [
    "그대들의 활약, 참으로",
    "훌륭했네. 상을 내리지‼",
    "정말 잘해 주었네.",
    "다음에도 기대하겠네‼"
   ],
   "status": "approved",
   "notes": ""
  },
  {
   "id": "A:07c562",
   "label": "king_message[5]",
   "addr": "07c562",
   "size_bytes": 134,
   "source_rows": [
    "　なんということだ！　姫を誘拐",
    "",
    "　されてしまうとは！だが仮にも",
    "",
    "　王女、そう簡単に殺すとは思え",
    "",
    "　ないのじゃが‥‥。心配じゃ。"
   ],
   "layout": {
    "rows": 7,
    "max_cells": 15,
    "lead_blank": 1,
    "vertical_original": false,
    "palettes": [
     0
    ]
   },
   "ko_rows": [
    "이럴 수가! 공주가",
    "납치당하다니! 하나 명색이",
    "왕녀, 쉽게 죽이진 않을",
    "테지만‥‥. 걱정이구나."
   ],
   "status": "approved",
   "notes": ""
  },
  {
   "id": "A:07c5e8",
   "label": "king_message[7]",
   "addr": "07c5e8",
   "size_bytes": 134,
   "source_rows": [
    "　二神器の内、一つを奪われたと",
    "",
    "　申すか！このままでは、世界が",
    "",
    "　魔物共のものになってしまう。",
    "",
    "　あとは貴公等だけが頼りじゃ‼"
   ],
   "layout": {
    "rows": 7,
    "max_cells": 15,
    "lead_blank": 1,
    "vertical_original": false,
    "palettes": [
     0
    ]
   },
   "ko_rows": [
    "두 신기 중 하나를",
    "빼앗겼다고? 이대로는",
    "세계가 마물들의 것이 되고",
    "만다. 믿을 건 그대들뿐‼"
   ],
   "status": "approved",
   "notes": ""
  },
  {
   "id": "A:07c68c",
   "label": "villain[0]",
   "addr": "07c68c",
   "size_bytes": 118,
   "source_rows": [
    "　きさまらの魔法は、我が魔力に",
    "",
    "　よって封じ込めた。",
    "",
    "　これで魔法は使えんぞ‥‼",
    "",
    "　闇の力をおもい知るがよい‼"
   ],
   "layout": {
    "rows": 7,
    "max_cells": 15,
    "lead_blank": 1,
    "vertical_original": false,
    "palettes": [
     0
    ]
   },
   "ko_rows": [
    "네놈들 마법은 내 마력으로",
    "봉인했다. 이제 마법은",
    "쓸 수 없다‥‼",
    "어둠의 힘을 맛보아라‼"
   ],
   "status": "approved",
   "notes": ""
  },
  {
   "id": "A:07c702",
   "label": "villain[1]",
   "addr": "07c702",
   "size_bytes": 128,
   "source_rows": [
    "　貴様等なぜ私の邪魔をするのだ！",
    "",
    "　だがそれもここまでだ‼",
    "",
    "　我が僕“ゼラー”の餌になるが",
    "",
    "　いいわ‼　ハッハハハハ‥。"
   ],
   "layout": {
    "rows": 7,
    "max_cells": 16,
    "lead_blank": 1,
    "vertical_original": false,
    "palettes": [
     0
    ]
   },
   "ko_rows": [
    "어찌 날 방해하는 것이냐!",
    "하나 그것도 여기까지다‼",
    "내 종 “젤라”의 먹이가",
    "되어라‼ 핫하하하하‥."
   ],
   "status": "approved",
   "notes": "ゼラー 표기(젤라/제라) 사람 확인"
  },
  {
   "id": "A:07c782",
   "label": "villain[2]",
   "addr": "07c782",
   "size_bytes": 132,
   "source_rows": [
    "　やはり来たか‥！だがこれで、",
    "",
    "　王女を含め五人の生け贄全てが",
    "",
    "　揃った。残るは二神器のみ！",
    "",
    "　貴様等はここで死んでもらう‼"
   ],
   "layout": {
    "rows": 7,
    "max_cells": 15,
    "lead_blank": 1,
    "vertical_original": false,
    "palettes": [
     0
    ]
   },
   "ko_rows": [
    "역시 왔군‥! 이것으로",
    "왕녀를 포함한 다섯 제물이",
    "모두 모였다. 남은 건 두",
    "신기뿐! 여기서 죽어라‼"
   ],
   "status": "approved",
   "notes": ""
  },
  {
   "id": "A:07c806",
   "label": "villain[3]",
   "addr": "07c806",
   "size_bytes": 130,
   "source_rows": [
    "　おのれ！まだ邪魔だてするのか！",
    "",
    "　此にある二神器は私がもらうぞ‼",
    "",
    "　ゆけい“ファイレス”‼奴等を",
    "",
    "　消し炭にしてしまえ‼"
   ],
   "layout": {
    "rows": 7,
    "max_cells": 16,
    "lead_blank": 1,
    "vertical_original": false,
    "palettes": [
     0
    ]
   },
   "ko_rows": [
    "이놈! 아직도 방해하는가!",
    "두 신기는 내가 가져가마‼",
    "가라 “파이레스”‼ 놈들을",
    "숯덩이로 만들어 버려라‼"
   ],
   "status": "approved",
   "notes": "ファイレス 표기 사람 확인"
  },
  {
   "id": "A:07c888",
   "label": "villain[4]",
   "addr": "07c888",
   "size_bytes": 122,
   "source_rows": [
    "　ついに此まで来おったか‼だが",
    "",
    "　私の計画、扉の奥に封じられし",
    "",
    "　闇の帝王“ルシファー”様復活",
    "",
    "　の邪魔はさせぬ‼"
   ],
   "layout": {
    "rows": 7,
    "max_cells": 15,
    "lead_blank": 1,
    "vertical_original": false,
    "palettes": [
     0
    ]
   },
   "ko_rows": [
    "기어이 여기까지 왔느냐‼",
    "허나 문 너머 봉인된",
    "어둠의 제왕 “루시퍼”님의",
    "부활은 막지 못한다‼"
   ],
   "status": "approved",
   "notes": "私の計画 생략(폭 제한)"
  },
  {
   "id": "A:07c902",
   "label": "villain[5]",
   "addr": "07c902",
   "size_bytes": 136,
   "source_rows": [
    "　前の“ゴーダ”はほんの座興よ！",
    "",
    "　今度は私が相手だ‼その二神器",
    "",
    "　は、扉の奥“アビス”の底深く",
    "",
    "　沈め、二度と使えないように、"
   ],
   "layout": {
    "rows": 7,
    "max_cells": 16,
    "lead_blank": 1,
    "vertical_original": false,
    "palettes": [
     0
    ]
   },
   "ko_rows": [
    "“고다”는 여흥일 뿐이다!",
    "이번엔 내가 상대다‼ 그",
    "두 신기는 문 너머",
    "“어비스” 깊이 묻어"
   ],
   "status": "approved",
   "notes": "다음 화면(07c98a)으로 문장이 이어짐"
  },
  {
   "id": "A:07c98a",
   "label": "villain[6]",
   "addr": "07c98a",
   "size_bytes": 130,
   "source_rows": [
    "　してやる‼　　その時こそ",
    "",
    "“ルシファー”様の支配なさる、",
    "",
    "“闇の世紀”が始まるのだ！さあ",
    "",
    "　貴様等も生け贄になるがいい‼"
   ],
   "layout": {
    "rows": 7,
    "max_cells": 15,
    "lead_blank": 0,
    "vertical_original": false,
    "palettes": [
     0
    ]
   },
   "ko_rows": [
    "다시는 못 쓰게 해주마‼",
    "그때야말로 “루시퍼”님이",
    "다스리는 “어둠의 세기”가",
    "열린다! 너희도 제물이다‼"
   ],
   "status": "approved",
   "notes": ""
  },
  {
   "id": "A:07ca0c",
   "label": "ending",
   "addr": "07ca0c",
   "size_bytes": 116,
   "source_rows": [
    "　かくして四人の勇者は、伝承の",
    "",
    "　とおり魔物を再び封印し、王国",
    "",
    "　に再び、平和をもたらしたので",
    "",
    "　ある‥‥。"
   ],
   "layout": {
    "rows": 7,
    "max_cells": 15,
    "lead_blank": 1,
    "vertical_original": false,
    "palettes": [
     0
    ]
   },
   "ko_rows": [
    "이리하여 네 용사는",
    "전승대로 마물을 다시",
    "봉인하고, 왕국에 다시",
    "평화를 가져온 것이다‥‥."
   ],
   "status": "approved",
   "notes": ""
  },
